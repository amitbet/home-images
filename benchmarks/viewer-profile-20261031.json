  "findings": [
    {
      "issue": "Preload resolution mismatch",
      "evidence": "Completed 640x295 landscape image marked as 2560x1280 preview on portrait-to-landscape fullscreen navigation. Reproduced twice.",
      "source": [
        "web/app.js:1309",
        "web/app.js:1387",
        "web/app.js:1406"
      ],
      "action": "Size requests from the target photo and stage; store the actual request variant; upgrade any undersized preload after display."
    },
    {
      "issue": "Dynamic viewer variants bypass server cache",
      "evidence": "Repeated dynamic variant median TTFB 166ms; warmed cacheable variant 17ms. Different output bounds and payloads prevent treating this as a pure end-to-end speedup.",
      "source": [
        "thumbnails.go:171",
        "web/app.js:1309"
      ],
      "action": "Choose a bounded set of cacheable viewer variants shared by normal fetches, fullscreen and prefetch."
    },
    {
      "issue": "No foreground priority between HTTP render jobs",
      "evidence": "Two channel slots serve thumbnails, viewer and foreground face crops without priority; background decoder is already separate. Contention sample is noisy, with median paired TTFB increase of 73ms and one -820ms outlier.",
      "source": [
        "library.go:87",
        "thumbnails.go:158",
        "thumbnails.go:216"
      ],
      "action": "Use explicit visible-viewer, visible-grid, speculative priority classes; preserve concurrency/memory bounds, cancellation and fairness. Promote queued prefetch when it becomes visible. Add queue/render/cache Server-Timing before attributing long stalls to this queue."
    },
    {
      "issue": "Slow body delivery",
      "evidence": "One 188302-byte request: TTFB 227ms, body download 5402ms. Actual UI 2560x1440 request: TTFB 423ms, body download 2926ms.",
      "source": [
        "api.go:338",
        "web/app.js:1352"
      ],
      "action": "Measure network/write delays separately. Viewer waits for response.blob before displaying, so partial body delivery cannot sharpen it."
    }
  ]
